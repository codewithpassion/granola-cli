{
  "name": "granola-cli",
  "version": "0.1.0",
  "description": "Agent-first CLI for Granola meeting notes via MCP",
  "type": "module",
  "bin": {
    "granola": "./granola"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile granola",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
